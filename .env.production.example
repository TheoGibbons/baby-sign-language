# EC2 database settings. Copy to .env.database on the EC2 checkout.
POSTGRES_USER=baby_signs
# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=baby_signs

# PostgreSQL deliberately bypasses Traefik and listens directly on the host.
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5436
#POSTGRES_TLS_HOST=db.example.com

# Recommended: Vercel Static IP(s), comma separated, each with /32.
# Example: 198.51.100.10/32,198.51.100.11/32
#POSTGRES_ALLOWED_CIDRS=CHANGE_ME/32
POSTGRES_ALLOWED_CIDRS=0.0.0.0/0

# Setting POSTGRES_ALLOWED_CIDRS=0.0.0.0/0 exposes the login prompt to the whole
# internet. scripts/deploy.sh refuses that unless this explicit escape hatch is
# set to true. Prefer Vercel Static IPs and an EC2 security-group allowlist.
ALLOW_PUBLIC_DATABASE=true

# Only needed if the app is ever moved off Vercel onto this instance, which
# scripts/deploy.sh does not do. Set it to the public DNS name and start the app
# with docker-compose.traefik.yml plus docker-compose.prod.yml.
#APP_HOST=signs.example.com
