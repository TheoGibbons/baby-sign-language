# Local Compose settings. Copy to .env.database.
POSTGRES_USER=baby_signs
POSTGRES_PASSWORD=baby-signs-local-only
POSTGRES_DB=baby_signs
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5436
POSTGRES_TLS_HOST=localhost
POSTGRES_ALLOWED_CIDRS=127.0.0.1/32

# Standalone application container, published on loopback by
# docker-compose.override.yml.
APP_BIND=127.0.0.1
APP_PORT=3082

# Only read by docker-compose.traefik.yml, so it is unused in standalone mode.
APP_HOST=signs.localhost

# Compiled into the client bundle; bump it to invalidate every browser's cached
# copy of the sign list.
NEXT_PUBLIC_CACHE_VERSION=1
