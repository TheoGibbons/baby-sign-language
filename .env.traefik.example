# Copy to .env when running through the shared local Traefik proxy. Same
# variables as .env.example; only the hostname differs, because the app is
# reached at signs.localhost through the proxy rather than on a loopback port.
POSTGRES_USER=baby_signs
POSTGRES_PASSWORD=baby-signs-local-only
POSTGRES_DB=baby_signs
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5436
POSTGRES_TLS_HOST=localhost
POSTGRES_ALLOWED_CIDRS=127.0.0.1/32

# Read by docker-compose.traefik.yml. Any *.localhost name works without DNS.
APP_HOST=signs.localhost

NEXT_PUBLIC_CACHE_VERSION=1
